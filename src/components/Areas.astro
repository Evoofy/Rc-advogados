---
import { Icon } from 'astro-icon/components';
import { areas } from '../data/site';
---

<section id="areas" class="relative overflow-hidden bg-ink-2">
	<div data-hscroll class="flex min-h-svh flex-col justify-center py-24 lg:py-0">
		<div class="mx-auto mb-12 flex w-full max-w-7xl flex-wrap items-end justify-between gap-6 px-4 md:px-6">
			<div>
				<p data-reveal class="text-brand mb-5 flex items-center gap-3 text-sm font-medium tracking-[0.2em] uppercase">
					<span class="bg-brand h-px w-10"></span> Serviços
				</p>
				<h2 class="text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
					<span class="line"><span data-split-line>Áreas em que</span></span>
					<span class="line"><span data-split-line class="font-serif font-normal italic text-brand">atuamos</span></span>
				</h2>
			</div>
			<div data-reveal class="flex items-center gap-4">
				<span class="text-mist hidden text-sm lg:block">Role para explorar</span>
				<div class="hidden h-px w-40 overflow-hidden bg-white/10 lg:block">
					<div data-hscroll-progress class="bg-brand h-full w-full origin-left scale-x-0"></div>
				</div>
			</div>
		</div>

		<div
			data-hscroll-track
			class="flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 md:px-6 lg:snap-none lg:overflow-visible lg:pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))]"
		>
			{
				areas.filter((a) => a.featured).map((a, i) => (
					<a
						href={`/areas#${a.slug}`}
						class="group relative h-[520px] w-[80vw] max-w-[380px] shrink-0 snap-start overflow-hidden rounded-[2rem] border border-white/8"
					>
						<img
							src={a.img}
							alt=""
							loading="lazy"
							class="absolute inset-0 h-full w-full object-cover grayscale transition-all duration-[1.2s] ease-[cubic-bezier(.2,.8,.2,1)] group-hover:scale-110 group-hover:grayscale-0"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/10" />
						<div class="relative flex h-full flex-col justify-between p-7">
							<div class="flex items-start justify-between">
								<span class="glass rounded-full px-3 py-1 font-mono text-xs">0{i + 1}</span>
								<span class="grid h-11 w-11 place-items-center rounded-full bg-white text-black transition-all duration-500 group-hover:rotate-45 group-hover:bg-brand">
									<Icon name="lucide:arrow-up-right" class="h-5 w-5" />
								</span>
							</div>
							<div>
								<h3 class="text-3xl leading-tight font-semibold tracking-tight">{a.title}</h3>
								<p class="mt-3 max-h-0 overflow-hidden text-sm leading-relaxed text-white/75 opacity-0 transition-all duration-700 group-hover:max-h-40 group-hover:opacity-100">
									{a.desc}
								</p>
								<span class="bg-brand mt-5 block h-0.5 w-10 transition-all duration-700 group-hover:w-full" />
							</div>
						</div>
					</a>
				))
			}
			<div class="flex w-[80vw] max-w-[380px] shrink-0 snap-start flex-col justify-center rounded-[2rem] border border-dashed border-white/15 p-8">
				<p class="text-3xl font-semibold tracking-tight">Não encontrou sua área?</p>
				<p class="text-mist mt-3">Atuamos também em Penal Empresarial, Penal Tributário e Defesa Criminal Eleitoral.</p>
				<a
					href="/areas"
					class="text-brand mt-8 inline-flex items-center gap-2 font-semibold hover:underline"
				>
					Ver todas as áreas <Icon name="lucide:arrow-right" class="h-4 w-4" />
				</a>
			</div>
			<div class="hidden w-[8vw] shrink-0 lg:block" aria-hidden="true"></div>
		</div>
	</div>
</section>
