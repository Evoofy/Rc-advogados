---
import { Icon } from 'astro-icon/components';
import { faq, contact } from '../data/site';
import Eyebrow from './Eyebrow.astro';
---

<section class="relative py-28 md:py-36">
	<div class="mx-auto grid max-w-7xl gap-14 px-4 md:px-6 lg:grid-cols-[1fr_1.4fr]">
		<div class="lg:sticky lg:top-32 lg:self-start">
			<Eyebrow>Perguntas frequentes</Eyebrow>
			<h2 class="text-[clamp(2.4rem,5vw,4.2rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
				<span class="line"><span data-split-line>Dúvidas</span></span>
				<span class="line"><span data-split-line class="font-serif font-normal italic text-brand">comuns</span></span>
			</h2>
			<p data-reveal class="text-mist mt-6 max-w-sm">
				Encontre respostas para as dúvidas mais comuns sobre nossos serviços.
			</p>
			<a
				data-reveal
				href={contact.whatsapp}
				target="_blank"
				rel="noopener"
				class="mt-8 inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-3 text-sm font-medium transition hover:border-white/40 hover:bg-white/5"
			>
				Ainda tem dúvidas? Fale com a gente <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
			</a>
		</div>

		<div class="divide-y divide-white/8 border-y border-white/8" data-accordion>
			{
				faq.map((item, i) => (
					<div data-reveal class:list={['acc-item', i === 0 && 'is-open']}>
						<button
							type="button"
							class="flex w-full items-center justify-between gap-6 py-7 text-left text-lg font-medium md:text-xl"
							aria-expanded={i === 0 ? 'true' : 'false'}
						>
							{item.q}
							<span class="acc-icon grid h-10 w-10 shrink-0 place-items-center rounded-full border border-white/15">
								<Icon name="lucide:plus" class="h-4 w-4" />
							</span>
						</button>
						<div class="acc-panel">
							<div>
								<p class="text-mist max-w-2xl pb-7 leading-relaxed">{item.a}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
