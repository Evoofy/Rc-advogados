---
import { contact, nav, areas } from '../data/site';
import { Icon } from 'astro-icon/components';
import { landings } from '../data/landings';
---

<footer class="relative overflow-hidden px-4 pt-20 pb-8 md:px-6">
	<div class="mx-auto max-w-7xl">
		<div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr_1.2fr]">
			<div>
				<img src="/images/logo.png" alt="RC Advogados" class="h-14 w-14" width="56" height="56" loading="lazy" />
				<p class="text-mist mt-5 max-w-xs text-sm">
					Reginaldo Costa Advogados Associados · {contact.oab}. Hub de Soluções Jurídicas em Limeira – SP.
				</p>
				<div class="mt-6 flex gap-2">
					{
						contact.social.map((s) => (
							<a
								href={s.href}
								aria-label={s.label}
								class="hover:border-brand hover:bg-brand grid h-10 w-10 place-items-center rounded-full border border-white/10 transition hover:text-black"
							>
								<Icon name={s.icon} class="h-4 w-4" />
							</a>
						))
					}
				</div>
			</div>
			<div>
				<p class="text-sm font-semibold">Explorar</p>
				<ul class="text-mist mt-5 space-y-3 text-sm">
					{nav.map((n) => <li><a href={n.href} class="transition hover:text-white">{n.label}</a></li>)}
					<li><a href="/consultar-processos" class="transition hover:text-white">Consultar processos</a></li>
				</ul>
			</div>
			<div>
				<p class="text-sm font-semibold">Áreas</p>
				<ul class="text-mist mt-5 space-y-3 text-sm">
					{
						areas
							.filter((a) => a.featured)
							.map((a) => (
								<li>
									<a href={`/areas#${a.slug}`} class="transition hover:text-white">{a.title}</a>
								</li>
							))
					}
				</ul>
			</div>
			<div>
				<p class="text-sm font-semibold">Seus direitos</p>
				<ul class="text-mist mt-5 space-y-3 text-sm">
					{
						landings.map((l) => (
							<li>
								<a href={`/${l.slug}`} class="transition hover:text-white">
									{l.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<p class="text-sm font-semibold">Contato</p>
				<a href={contact.whatsapp} target="_blank" rel="noopener" class="hover:text-brand mt-5 block text-2xl font-semibold tracking-tight transition">
					{contact.phone}
				</a>
				<a href={`mailto:${contact.email}`} class="text-mist mt-2 block text-sm transition hover:text-white">{contact.email}</a>
				<a href={contact.maps} target="_blank" rel="noopener" class="text-mist mt-5 block text-sm transition hover:text-white">
					{contact.street}<br />{contact.city}
				</a>
				<p class="text-mist mt-3 text-sm">{contact.hours}</p>
			</div>
		</div>

		<p
			class="pointer-events-none mt-20 text-center text-[19vw] leading-[0.8] font-semibold tracking-[-0.06em] text-transparent select-none [-webkit-text-stroke:1px_rgb(255_255_255/0.12)]"
			data-footer-word
			aria-hidden="true"
		>
			RC Adv.
		</p>

		<div class="text-mist mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-white/8 pt-8 text-xs">
			<p>© 2026 Reginaldo Costa Adv. Assoc. · Desenvolvido por Evoo Marketing</p>
			<div class="flex gap-6">
				<a href="/politica-de-privacidade" class="hover:text-white">Política de Privacidade</a>
				<a href="/termos-de-uso" class="hover:text-white">Termos de Uso</a>
			</div>
		</div>
	</div>
</footer>
