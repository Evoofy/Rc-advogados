---
import { Icon } from 'astro-icon/components';
import { contact, nav } from '../data/site';
---

<section id="contato" class="relative overflow-hidden px-4 pb-4 md:px-6">
	<div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-brand text-black">
		<img src="/images/gavel.jpg" alt="" loading="lazy" class="absolute -top-[15%] left-0 h-[130%] w-full object-cover opacity-20 mix-blend-multiply grayscale" data-parallax="-10" />
		<div class="relative grid items-center gap-12 p-8 py-20 md:p-16 lg:grid-cols-[1.4fr_1fr]">
			<h2 class="text-[clamp(2.6rem,6.5vw,6rem)] leading-[0.92] font-semibold tracking-[-0.05em]">
				<span class="line"><span data-split-line>Vamos falar</span></span>
				<span class="line"><span data-split-line>sobre o seu</span></span>
				<span class="line"><span data-split-line class="font-serif font-normal italic">caso?</span></span>
			</h2>
			<div class="flex flex-col items-start gap-8 lg:items-center">
				<a
					href={contact.whatsapp}
					target="_blank"
					rel="noopener"
					data-magnetic
					class="group relative grid h-48 w-48 place-items-center rounded-full bg-black text-center text-white md:h-56 md:w-56"
				>
					<span class="absolute inset-0 scale-0 rounded-full bg-white transition-transform duration-500 ease-[cubic-bezier(.7,0,.2,1)] group-hover:scale-100"></span>
					<span class="relative z-10 flex flex-col items-center gap-2 font-semibold transition-colors group-hover:text-black">
						<Icon name="lucide:message-circle" class="h-8 w-8" />
						Fale conosco
					</span>
				</a>
				<p class="max-w-xs text-sm text-black/70 lg:text-center">
					Primeira conversa sem compromisso. Respondemos pelo WhatsApp em horário comercial.
				</p>
			</div>
		</div>
	</div>
</section>

<footer class="relative overflow-hidden px-4 pt-20 pb-8 md:px-6">
	<div class="mx-auto max-w-7xl">
		<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
			<div>
				<img src="/images/logo.png" alt="RC Advogados" class="h-14 w-14" width="56" height="56" loading="lazy" />
				<p class="text-mist mt-5 max-w-xs text-sm">
					Reginaldo Costa Advogados Associados · {contact.oab}. Hub de Soluções Jurídicas em Limeira – SP.
				</p>
				<div class="mt-6 flex gap-2">
					{
						['lucide:facebook', 'lucide:instagram', 'lucide:linkedin'].map((i) => (
							<a href="#" aria-label={i.split(':')[1]} class="grid h-10 w-10 place-items-center rounded-full border border-white/10 transition hover:border-brand hover:bg-brand hover:text-black">
								<Icon name={i} class="h-4 w-4" />
							</a>
						))
					}
				</div>
			</div>
			<div>
				<p class="text-sm font-semibold">Explorar</p>
				<ul class="text-mist mt-5 space-y-3 text-sm">
					{nav.map((n) => <li><a href={n.href} class="transition hover:text-white">{n.label}</a></li>)}
				</ul>
			</div>
			<div>
				<p class="text-sm font-semibold">Localização</p>
				<p class="text-mist mt-5 text-sm">{contact.address}</p>
				<p class="mt-6 text-sm font-semibold">Atendimento</p>
				<p class="text-mist mt-3 text-sm">{contact.hours}</p>
			</div>
			<div>
				<p class="text-sm font-semibold">Contato</p>
				<a href={`mailto:${contact.email}`} class="text-mist mt-5 block text-sm transition hover:text-white">{contact.email}</a>
				<a href={contact.whatsapp} target="_blank" rel="noopener" class="mt-3 block text-2xl font-semibold tracking-tight transition hover:text-brand">
					{contact.phone}
				</a>
			</div>
		</div>

		<p
			class="pointer-events-none mt-20 text-center text-[19vw] leading-[0.8] font-semibold tracking-[-0.06em] text-transparent select-none [-webkit-text-stroke:1px_rgb(255_255_255/0.12)]"
			data-footer-word
			aria-hidden="true"
		>
			RC Adv.
		</p>

		<div class="text-mist mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-white/8 pt-8 text-xs">
			<p>© 2026 Reginaldo Costa Adv. Assoc. · Desenvolvido por Evoo Marketing</p>
			<div class="flex gap-6">
				<a href="#" class="hover:text-white">Política de Privacidade</a>
				<a href="#" class="hover:text-white">Termos de Uso</a>
			</div>
		</div>
	</div>
</footer>
