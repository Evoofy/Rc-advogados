---
import { Icon } from 'astro-icon/components';
import { areas, contact } from '../data/site';

const ticker = [...areas.map((a) => a.title), 'Golpe do PIX', 'Voo Cancelado', 'Acidente de Trabalho'];
---

<section id="top" class="relative flex min-h-svh flex-col overflow-hidden pt-28">
	<!-- Backdrop -->
	<div class="bg-grid absolute inset-0" aria-hidden="true"></div>
	<div class="orb bg-brand -top-40 -left-40 h-[36rem] w-[36rem]" data-orb aria-hidden="true"></div>
	<div class="orb -right-40 bottom-0 h-[30rem] w-[30rem] bg-[#7a2cff]/60" data-orb aria-hidden="true"></div>

	<div class="relative mx-auto grid w-full max-w-7xl flex-1 items-center gap-16 px-4 pb-16 md:px-6 lg:grid-cols-[1.15fr_1fr]">
		<!-- Copy -->
		<div>
			<div
				data-hero-fade
				class="glass mb-8 inline-flex items-center gap-2 rounded-full py-1.5 pr-4 pl-1.5 text-xs text-white/80"
			>
				<span class="bg-brand rounded-full px-2 py-0.5 font-semibold text-black">Novo</span>
				Consultoria &amp; Assessoria Jurídica
			</div>

			<h1 class="text-[clamp(2.8rem,7.2vw,6.4rem)] leading-[0.95] font-semibold tracking-[-0.045em]">
				<span class="line"><span data-hero-line>Acesso jurídico</span></span>
				<span class="line">
					<span data-hero-line class="font-serif font-normal italic text-gradient pr-2">democratizado</span>
				</span>
				<span class="line"><span data-hero-line>para você.</span></span>
			</h1>

			<p data-hero-fade class="text-mist mt-8 max-w-md text-lg leading-relaxed">
				Condições especiais para que você possa buscar os seus direitos — com a agilidade do digital e a
				segurança de mais de duas décadas de experiência.
			</p>

			<div data-hero-fade class="mt-10 flex flex-wrap items-center gap-3">
				<a
					href={contact.whatsapp}
					target="_blank"
					rel="noopener"
					data-magnetic
					class="group bg-brand relative inline-flex items-center gap-3 overflow-hidden rounded-full py-2 pr-2 pl-6 font-semibold text-black"
				>
					<span class="relative z-10">Falar com um advogado</span>
					<span
						class="relative z-10 grid h-10 w-10 place-items-center rounded-full bg-black text-white transition-transform duration-500 group-hover:rotate-45"
					>
						<Icon name="lucide:arrow-up-right" class="h-5 w-5" />
					</span>
					<span
						class="absolute inset-0 translate-y-full rounded-full bg-white transition-transform duration-500 ease-[cubic-bezier(.7,0,.2,1)] group-hover:translate-y-0"
					></span>
				</a>
				<a
					href="#areas"
					class="inline-flex items-center gap-2 rounded-full border border-white/15 px-6 py-4 text-sm font-medium text-white/85 transition hover:border-white/40 hover:bg-white/5"
				>
					Ver áreas de atuação <Icon name="lucide:arrow-down" class="h-4 w-4" />
				</a>
			</div>

			<div data-hero-fade class="mt-14 flex items-center gap-5">
				<div class="flex -space-x-3">
					{
						['adv-reginaldo', 'adv-eliezer', 'adv-mariane', 'adv-ricardo'].map((n) => (
							<img
								src={`/images/${n}.webp`}
								alt=""
								width="44"
								height="44"
								class="ring-ink h-11 w-11 rounded-full object-cover object-top ring-2"
							/>
						))
					}
				</div>
				<div class="text-sm">
					<div class="flex gap-0.5 text-brand">
						<span class="text-sm tracking-[0.15em]">★★★★★</span>
					</div>
					<p class="text-mist mt-1">Clientes que recomendam em Limeira – SP</p>
				</div>
			</div>
		</div>

		<!-- Visual -->
		<div class="relative mx-auto aspect-[4/5] w-full max-w-md lg:max-w-none" data-hero-visual>
			<div data-depth="0.3" class="ring-glow absolute inset-0 rounded-[2rem] p-2">
				<div class="relative h-full w-full overflow-hidden rounded-[1.6rem]">
					<img
						src="/images/fachada.webp"
						alt="Fachada do escritório Reginaldo Costa Advogados Associados"
						class="h-full w-full scale-110 object-cover"
						data-hero-img
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
					<div class="absolute right-6 bottom-6 left-6">
						<p class="text-xs tracking-[0.2em] text-white/60 uppercase">Sede · Limeira</p>
						<p class="mt-1 text-xl font-semibold">R. Treze de Maio, 151</p>
					</div>
				</div>
			</div>

			<!-- Floating card: case status -->
			<div
				data-depth="0.9"
				data-float
				class="glass absolute top-10 -left-6 w-64 rounded-2xl p-4 shadow-2xl shadow-black/50 sm:-left-12"
			>
				<div class="flex items-center justify-between text-xs">
					<span class="text-mist">Seu processo</span>
					<span class="flex items-center gap-1.5 text-emerald-400">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
						</span>
						Em andamento
					</span>
				</div>
				<p class="mt-3 text-sm font-semibold">Ação trabalhista · #0042</p>
				<div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/10">
					<div data-progress class="from-brand to-brand-2 h-full w-0 rounded-full bg-gradient-to-r"></div>
				</div>
				<div class="text-mist mt-2 flex justify-between text-[11px]">
					<span>Petição</span><span>Audiência</span><span>Sentença</span>
				</div>
			</div>

			<!-- Floating card: stat -->
			<div
				data-depth="1.3"
				data-float
				class="glass absolute -right-4 bottom-28 rounded-2xl p-4 shadow-2xl shadow-black/50 sm:-right-10"
			>
				<p class="text-mist text-xs">Experiência</p>
				<p class="mt-1 text-4xl font-semibold tracking-tight">+20<span class="text-brand">a</span></p>
				<p class="text-mist text-xs">de expertise jurídica</p>
			</div>

			<!-- Floating card: chat -->
			<div
				data-depth="0.6"
				data-float
				class="glass absolute -bottom-6 left-6 flex items-center gap-3 rounded-full py-2 pr-5 pl-2 shadow-2xl shadow-black/50"
			>
				<span class="bg-brand grid h-9 w-9 place-items-center rounded-full text-black">
					<Icon name="lucide:message-circle" class="h-5 w-5" />
				</span>
				<span class="text-sm">
					<span class="font-semibold">Atendimento</span>
					<span class="text-mist"> presencial &amp; digital</span>
				</span>
			</div>
		</div>
	</div>

	<!-- Ticker -->
	<div class="marquee-wrap relative border-y border-white/8 bg-white/[0.02] py-5">
		<div class="marquee" style="--dur: 45s">
			{
				[0, 1].map(() => (
					<div class="flex shrink-0 items-center">
						{ticker.map((t) => (
							<span class="flex items-center gap-8 px-8 text-2xl font-medium tracking-tight whitespace-nowrap text-white/70 md:text-3xl">
								{t}
								<span class="text-brand text-lg">✦</span>
							</span>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>
