---
import { Icon } from 'astro-icon/components';
import { shortDate, readingTime, type Post } from '../lib/blog';

interface Props {
	post: Post;
}
const { post } = Astro.props;
const d = shortDate(post.data.date);
---

<a href={`/blog/${post.id}`} data-reveal data-cat={post.data.category} class="group flex flex-col">
	<div class="dark-scope bg-ink-3 relative aspect-[4/3] overflow-hidden rounded-[1.75rem]">
		<img
			src={post.data.cover}
			alt=""
			loading="lazy"
			class="h-full w-full object-cover transition-transform duration-[1.2s] ease-[cubic-bezier(.2,.8,.2,1)] group-hover:scale-110"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
		<span class="glass absolute top-4 left-4 flex flex-col items-center rounded-2xl px-3 py-2 leading-none">
			<span class="text-xl font-semibold">{d.day}</span>
			<span class="text-mist mt-1 text-[11px] uppercase">{d.month}</span>
		</span>
		<span
			class="group-hover:bg-brand absolute top-4 right-4 grid h-11 w-11 place-items-center rounded-full bg-white text-black transition-all duration-500 group-hover:rotate-45"
		>
			<Icon name="lucide:arrow-up-right" class="h-5 w-5" />
		</span>
	</div>
	<div class="text-mist mt-5 flex items-center gap-3 text-xs">
		<span class="text-brand rounded-full border border-current/30 px-2.5 py-0.5">{post.data.category}</span>
		<span>{readingTime(post)} min de leitura</span>
	</div>
	<h3 class="group-hover:text-brand mt-3 text-xl leading-snug font-semibold tracking-tight transition-colors">
		{post.data.title}
	</h3>
	<p class="text-mist mt-2 line-clamp-2 text-sm leading-relaxed">{post.data.description}</p>
</a>
