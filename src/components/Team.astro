---
import { Icon } from 'astro-icon/components';
import { team } from '../data/site';
import Eyebrow from './Eyebrow.astro';
import TeamCard from './TeamCard.astro';
---

<section id="equipe" class="bg-ink-2 relative border-t border-white/8 py-28 md:py-40">
	<div class="mx-auto max-w-7xl px-4 md:px-6">
		<div class="mb-14 flex flex-wrap items-end justify-between gap-6">
			<div>
				<Eyebrow>Advogados</Eyebrow>
				<h2 class="text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
					<span class="line"><span data-split-line>Conheça quem</span></span>
					<span class="line"><span data-split-line>cuida do <span class="font-serif font-normal italic text-brand">seu caso</span></span></span>
				</h2>
			</div>
			<div data-reveal class="flex max-w-sm flex-col items-start gap-5">
				<p class="text-mist">Uma equipe multidisciplinar que une experiência de tribunal com a agilidade que o seu caso precisa.</p>
				<a
					href="/equipe"
					class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-medium transition hover:border-white/40 hover:bg-white/5"
				>
					Todos os advogados <Icon name="lucide:arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>

		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{team.slice(0, 4).map((p) => <TeamCard lawyer={p} />)}
		</div>
	</div>
</section>
