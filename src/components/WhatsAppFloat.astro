---
/**
 * Floating WhatsApp button (all pages). Uses the api.whatsapp.com link so the
 * Google Ads conversion trigger in GTM counts the click (see src/data/site.ts).
 */
import { whatsappMsg } from '../data/site';

const href = whatsappMsg('Olá! Vim pelo site e gostaria de falar com um advogado.');
---

<a
	id="whatsapp-float"
	href={href}
	target="_blank"
	rel="noopener"
	aria-label="Falar com a RC Advogados pelo WhatsApp"
	class="group fixed right-4 bottom-4 z-50 flex items-center gap-3 md:right-6 md:bottom-6"
>
	<span
		class="pointer-events-none hidden translate-x-2 rounded-full bg-white px-4 py-2 text-sm font-semibold whitespace-nowrap text-black opacity-0 shadow-lg transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 md:block"
	>
		Fale no WhatsApp
	</span>
	<span class="wa-btn relative grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/40 transition-transform duration-300 group-hover:scale-110">
		<svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true">
			<path
				d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.39 9.39 0 0 1-1.44-5.01c0-5.19 4.23-9.42 9.43-9.42 2.52 0 4.88.98 6.66 2.76a9.36 9.36 0 0 1 2.76 6.67c0 5.2-4.23 9.42-9.43 9.42m8.02-17.44A11.26 11.26 0 0 0 12.05.75C5.8.75.72 5.83.72 12.08c0 2 .52 3.95 1.52 5.66L.62 23.25l5.65-1.48a11.3 11.3 0 0 0 5.78 1.47h.01c6.24 0 11.32-5.08 11.33-11.33 0-3.03-1.18-5.87-3.32-8.01"
			></path>
		</svg>
	</span>
</a>

<style>
	/* Soft pulse ring (transform/opacity only, runs on the compositor) */
	.wa-btn::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: #25d366;
		z-index: -1;
		animation: wa-pulse 2.4s ease-out infinite;
	}
	@keyframes wa-pulse {
		0% { transform: scale(1); opacity: 0.55; }
		80%, 100% { transform: scale(1.6); opacity: 0; }
	}
	:global(html.menu-open) #whatsapp-float {
		opacity: 0;
		pointer-events: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.wa-btn::after { animation: none; }
	}
</style>
