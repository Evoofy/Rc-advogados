---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'RC Advogados — Hub de Soluções Jurídicas',
	description = 'Reginaldo Costa Advogados Associados. Consultoria e assessoria jurídica em Limeira – SP, presencial e digital.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#07070a" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body class="bg-ink text-white overflow-x-hidden">
		<div class="grain" aria-hidden="true"></div>
		<div class="cursor" aria-hidden="true"></div>
		<slot />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
