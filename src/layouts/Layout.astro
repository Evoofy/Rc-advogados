---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';

interface Props {
	title?: string;
	description?: string;
	/** Show the orange "Vamos falar sobre o seu caso?" banner above the footer */
	cta?: boolean;
}

const siteName = 'RC Advogados';
const {
	title,
	description = 'Reginaldo Costa Advogados Associados. Hub de Soluções Jurídicas em Limeira – SP, com atendimento presencial e 100% digital.',
	cta = true,
} = Astro.props;
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — Hub de Soluções Jurídicas`;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#07070a" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/images/fachada.webp" />
		<meta property="og:locale" content="pt_BR" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body class="bg-ink text-white overflow-x-hidden">
		<Nav />
		<main>
			<slot />
		</main>
		{cta && <CtaBanner />}
		<Footer />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
