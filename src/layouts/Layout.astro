---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Tracking from '../components/Tracking.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { asset } from '../lib/images';
import { organization, website } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	/** Share image: a `/images/...` photo (cropped to 1200×630 JPG) or an absolute URL */
	image?: string;
	/** Crop anchor for the share image, e.g. 'top' for portraits */
	imagePosition?: string;
	type?: 'website' | 'article' | 'profile';
	/** Keep the page out of search results */
	noindex?: boolean;
	/** Extra schema.org objects for this page */
	jsonLd?: object[];
	publishedTime?: Date;
	/** Show the orange "Vamos falar sobre o seu caso?" banner above the footer */
	cta?: boolean;
}

const siteName = 'RC Advogados';
const {
	title,
	description = 'Reginaldo Costa Advogados Associados: hub de soluções jurídicas em Limeira – SP, com atendimento presencial e 100% digital em todo o Brasil.',
	image,
	imagePosition,
	type = 'website',
	noindex = false,
	jsonLd = [],
	publishedTime,
	cta = true,
} = Astro.props;

const site = Astro.site!;
// Keep titles under ~60 chars: drop the brand suffix when it would overflow
const fullTitle = !title
	? `${siteName} | Advogados em Limeira – SP`
	: `${title} — ${siteName}`.length <= 60
		? `${title} — ${siteName}`
		: title;
const canonical = new URL(Astro.url.pathname, site).href;

let ogImage = new URL('/og/og-default.jpg', site).href;
let ogSize = { width: 1200, height: 630 };
if (image?.startsWith('/images/')) {
	const src = asset(image);
	const og = await getImage({ src, width: 1200, height: 630, fit: 'cover', position: imagePosition, format: 'jpg', quality: 80 });
	ogImage = new URL(og.src, site).href;
	// Astro never upscales, so sources narrower than 1200px keep their own width
	ogSize = { width: Math.min(1200, src.width), height: Math.min(630, src.height) };
} else if (image) {
	ogImage = image;
}

const schema = [organization(site), website(site), ...jsonLd];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Tracking />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
		<meta name="theme-color" content="#07070a" />

		<meta property="og:site_name" content="RC Advogados" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={String(ogSize.width)} />
		<meta property="og:image:height" content={String(ogSize.height)} />
		<meta property="og:image:alt" content={fullTitle} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<Font cssVariable="--font-manrope" preload />
		<Font cssVariable="--font-instrument" preload />

		<meta name="generator" content={Astro.generator} />
		<script is:inline>document.documentElement.classList.add('js');</script>
		{schema.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
	</head>
	<body class="bg-ink text-white overflow-x-hidden">
		<Nav />
		<main>
			<slot />
		</main>
		{cta && <CtaBanner />}
		<Footer />
		<WhatsAppFloat />
		<CookieBanner />
		<script>
			import '../scripts/motion';
			import '../scripts/track';
		</script>
	</body>
</html>
