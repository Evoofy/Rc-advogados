---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { whatsappMsg } from '../data/site';

const courts = [
	{ name: 'TJSP · e-SAJ', desc: 'Processos cíveis, criminais e de família na Justiça Estadual de São Paulo.', href: 'https://esaj.tjsp.jus.br/cpopg/open.do' },
	{ name: 'TRT-15', desc: 'Justiça do Trabalho de Campinas e região, incluindo Limeira.', href: 'https://trt15.jus.br/' },
	{ name: 'TRF-3', desc: 'Justiça Federal de SP e MS: previdenciário (INSS) e causas contra a União.', href: 'https://www.trf3.jus.br/' },
	{ name: 'TSE', desc: 'Processos e consultas da Justiça Eleitoral.', href: 'https://www.tse.jus.br/' },
	{ name: 'STJ', desc: 'Recursos no Superior Tribunal de Justiça.', href: 'https://processo.stj.jus.br/processo/pesquisa/' },
	{ name: 'STF', desc: 'Recursos e ações no Supremo Tribunal Federal.', href: 'https://portal.stf.jus.br/' },
];
---

<Layout title="Consultar processos" description="Acompanhe o andamento do seu processo nos principais tribunais ou fale diretamente com a equipe da RC Advogados.">
	<PageHero
		eyebrow="Área do cliente"
		lines={['Consultar', '*processos*']}
		lead="Acompanhe o andamento nos portais oficiais dos tribunais — ou peça a atualização diretamente para a nossa equipe."
		crumbs={[{ label: 'Consultar processos' }]}
	/>

	<section class="pb-24">
		<div class="mx-auto grid max-w-7xl gap-6 px-4 md:px-6 lg:grid-cols-[1fr_1.6fr]">
			<div data-reveal class="bg-brand flex flex-col justify-between rounded-[2rem] p-8 text-black md:p-10">
				<div>
					<Icon name="lucide:message-circle" class="h-10 w-10" />
					<h2 class="mt-8 text-3xl leading-tight font-semibold tracking-tight">Já é cliente RC?</h2>
					<p class="mt-3 text-black/70">
						Envie o número do processo ou o seu nome completo e a equipe responsável responde com o status atualizado e os próximos passos.
					</p>
				</div>
				<a
					href={whatsappMsg('Olá! Sou cliente e gostaria de saber o andamento do meu processo.')}
					target="_blank"
					rel="noopener"
					class="mt-10 inline-flex items-center justify-between gap-2 rounded-full bg-black py-2 pr-2 pl-6 font-semibold text-white"
				>
					Pedir atualização
					<span class="bg-brand grid h-10 w-10 place-items-center rounded-full text-black">
						<Icon name="lucide:arrow-up-right" class="h-5 w-5" />
					</span>
				</a>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				{
					courts.map((c) => (
						<a href={c.href} target="_blank" rel="noopener" data-reveal class="spotlight group border-line bg-ink-2 flex flex-col justify-between rounded-[1.75rem] border p-6">
							<div class="flex items-start justify-between">
								<span class="grid h-11 w-11 place-items-center rounded-xl bg-white/5">
									<Icon name="lucide:landmark" class="text-brand h-5 w-5" />
								</span>
								<Icon name="lucide:external-link" class="text-mist h-4 w-4 transition group-hover:text-white" />
							</div>
							<div class="mt-8">
								<p class="text-lg font-semibold">{c.name}</p>
								<p class="text-mist mt-1 text-sm">{c.desc}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
		<p class="text-mist mx-auto mt-8 max-w-7xl px-4 text-xs md:px-6">
			Os links direcionam para os portais oficiais dos tribunais. Processos em segredo de justiça só podem ser consultados pelas partes e seus advogados.
		</p>
	</section>
</Layout>
