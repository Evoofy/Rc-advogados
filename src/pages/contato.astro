---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import { contact, areas } from '../data/site';

const channels = [
	{ icon: 'lucide:message-circle', label: 'WhatsApp', value: contact.phone, href: contact.whatsapp, external: true },
	{ icon: 'lucide:mail', label: 'E-mail', value: contact.email, href: `mailto:${contact.email}` },
	{ icon: 'lucide:map-pin', label: 'Nossa localização', value: contact.address, href: contact.maps, external: true },
	{ icon: 'lucide:clock', label: 'Atendimento', value: contact.hours },
];
---

<Layout title="Contato" description="Fale com a RC Advogados pelo WhatsApp (19) 3713-5100, por e-mail ou visite nossa sede na R. Treze de Maio, 151 - Centro, Limeira – SP." cta={false}>
	<PageHero
		eyebrow="Nosso contato"
		lines={['Vamos nos', '*conectar*']}
		lead="Conte o seu caso. Respondemos rápido, sem compromisso, e direcionamos para o especialista certo."
		crumbs={[{ label: 'Contato' }]}
	/>

	<section class="pb-24">
		<div class="mx-auto grid max-w-7xl gap-6 px-4 md:px-6 lg:grid-cols-[1.25fr_1fr]">
			<!-- Form -->
			<form id="contact-form" data-reveal class="ring-glow bg-ink-2 rounded-[2rem] p-7 md:p-10" novalidate>
				<div class="flex items-center justify-between">
					<h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Entre em contato conosco</h2>
					<span class="hidden items-center gap-1.5 text-xs text-emerald-400 sm:flex">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
						</span>
						Online agora
					</span>
				</div>
				<p class="text-mist mt-2 text-sm">Sua mensagem chega ao escritório por e-mail e abrimos o WhatsApp com ela pronta, para você falar com a gente na hora.</p>

				<div class="mt-8 grid gap-4 sm:grid-cols-2">
					<label class="field">
						<span>Nome</span>
						<input name="nome" required autocomplete="name" placeholder="Seu nome completo" />
					</label>
					<label class="field">
						<span>Telefone</span>
						<input name="telefone" type="tel" required autocomplete="tel" placeholder="(19) 90000-0000" />
					</label>
					<label class="field sm:col-span-2">
						<span>E-mail</span>
						<input name="email" type="email" autocomplete="email" placeholder="voce@email.com" />
					</label>
					<fieldset class="sm:col-span-2">
						<legend class="text-mist mb-3 text-xs">Assunto</legend>
						<div class="flex flex-wrap gap-2">
							{
								['Golpe do PIX', 'Voo cancelado', 'Acidente de trabalho', ...areas.filter((a) => a.featured).map((a) => a.title), 'Outro'].map(
									(s, i) => (
										<label class="chip">
											<input type="radio" name="assunto" value={s} checked={i === 0} class="sr-only" />
											<span>{s}</span>
										</label>
									),
								)
							}
						</div>
					</fieldset>
					<label class="field sm:col-span-2">
						<span>Mensagem</span>
						<textarea name="mensagem" rows="4" required placeholder="Conte brevemente o que aconteceu"></textarea>
					</label>
				</div>

				<!-- Honeypot: hidden from people, bots fill it in -->
				<input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-px w-px opacity-0" />

				<label class="mt-6 flex items-start gap-3 text-sm text-white/75">
					<input type="checkbox" name="aceite" required class="accent-brand mt-0.5 h-4 w-4 shrink-0" />
					<span>
						Concordo com o uso dos meus dados para retorno do contato, conforme a{' '}
						<a href="/politica-de-privacidade/" class="text-brand underline underline-offset-2">Política de Privacidade</a>.
					</span>
				</label>

				<p data-form-error hidden role="alert" class="mt-4 text-sm text-red-400">Preencha nome, telefone e mensagem.</p>
				<p data-form-status hidden role="status" aria-live="polite" class="mt-4 flex items-start gap-2 rounded-2xl p-4 text-sm"></p>

				<button
					type="submit"
					data-magnetic
					class="group bg-brand relative mt-8 inline-flex items-center gap-3 overflow-hidden rounded-full py-2 pr-2 pl-6 font-semibold text-black"
				>
					<span class="relative z-10" data-submit-label>Enviar mensagem</span>
					<span class="relative z-10 grid h-10 w-10 place-items-center rounded-full bg-black text-white transition-transform duration-500 group-hover:rotate-45">
						<Icon name="lucide:arrow-up-right" class="h-5 w-5" />
					</span>
					<span class="absolute inset-0 translate-y-full rounded-full bg-white transition-transform duration-500 ease-[cubic-bezier(.7,0,.2,1)] group-hover:translate-y-0"></span>
				</button>
			</form>

			<!-- Channels -->
			<div class="grid gap-4">
				{
					channels.map((c) => {
						const Tag = c.href ? 'a' : 'div';
						return (
							<Tag
								href={c.href}
								target={c.external ? '_blank' : undefined}
								rel={c.external ? 'noopener' : undefined}
								data-reveal
								class="spotlight group border-line bg-ink-2 flex items-center gap-5 rounded-[1.75rem] border p-6"
							>
								<span class="group-hover:bg-brand grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-white/5 transition-colors duration-500 group-hover:text-black">
									<Icon name={c.icon} class="h-6 w-6" />
								</span>
								<span class="min-w-0 flex-1">
									<span class="text-mist block text-xs">{c.label}</span>
									<span class="mt-1 block font-semibold break-words">{c.value}</span>
								</span>
								{c.href && <Icon name="lucide:arrow-up-right" class="text-mist h-5 w-5 shrink-0 transition group-hover:text-white" />}
							</Tag>
						);
					})
				}
			</div>
		</div>

		<!-- Map -->
		<div class="mx-auto mt-6 max-w-7xl px-4 md:px-6">
			<div data-clip class="border-line relative h-[420px] overflow-hidden rounded-[2rem] border">
				<iframe
					title="Mapa: RC Advogados, R. Treze de Maio, 151 - Centro, Limeira – SP"
					data-map-src={contact.mapsEmbed}
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					class="h-full w-full [filter:invert(0.92)_hue-rotate(180deg)_saturate(0.6)_contrast(0.9)]"
				></iframe>
				<div data-map-gate class="bg-ink-2 absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
					<p class="max-w-sm text-sm text-white/75">
						O mapa é fornecido pelo Google, que pode gravar cookies no seu navegador. Veja a nossa{' '}
						<a href="/politica-de-cookies/" class="text-brand underline underline-offset-2">Política de Cookies</a>.
					</p>
					<div class="flex flex-wrap justify-center gap-2">
						<button type="button" data-map-load class="bg-brand rounded-full px-5 py-2.5 text-sm font-semibold text-black transition hover:bg-white">
							Carregar mapa
						</button>
						<a href={contact.maps} target="_blank" rel="noopener" class="rounded-full border border-white/15 px-5 py-2.5 text-sm transition hover:border-white/40">
							Abrir no Google Maps
						</a>
					</div>
				</div>
				<div class="glass pointer-events-none absolute top-5 left-5 flex items-center gap-3 rounded-2xl p-4">
					<img src="/images/logo.png" alt="" class="h-10 w-10" />
					<div class="text-sm">
						<p class="font-semibold">RC Advogados</p>
						<p class="text-mist">{contact.street}</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<Faq />
</Layout>

<style>
	.field {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.field > span {
		font-size: 0.75rem;
		color: var(--color-mist);
	}
	.field input,
	.field textarea {
		width: 100%;
		border-radius: 1rem;
		border: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(255 255 255 / 0.03);
		padding: 0.9rem 1.1rem;
		color: #fff;
		outline: none;
		transition:
			border-color 0.3s,
			background 0.3s,
			box-shadow 0.3s;
		resize: vertical;
	}
	.field input::placeholder,
	.field textarea::placeholder {
		color: rgb(255 255 255 / 0.3);
	}
	.field input:focus,
	.field textarea:focus {
		border-color: var(--color-brand);
		background: rgb(255 102 0 / 0.04);
		box-shadow: 0 0 0 4px rgb(255 102 0 / 0.12);
	}
	.chip span {
		display: inline-block;
		cursor: pointer;
		border-radius: 999px;
		border: 1px solid rgb(255 255 255 / 0.12);
		padding: 0.5rem 1rem;
		font-size: 0.85rem;
		color: rgb(255 255 255 / 0.75);
		transition: all 0.3s;
	}
	.chip:hover span {
		border-color: rgb(255 255 255 / 0.35);
	}
	.chip input:checked + span {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: #000;
		font-weight: 600;
	}
	.chip input:focus-visible + span {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}
</style>

<script>
	import { whatsappMsg, contactForm } from '../data/site';
	import { whenAllowed, getConsent, saveConsent } from '../scripts/consent';

	const map = document.querySelector<HTMLIFrameElement>('[data-map-src]');
	const gate = document.querySelector<HTMLElement>('[data-map-gate]');
	const loadMap = () => {
		if (!map || map.src) return;
		map.src = map.dataset.mapSrc!;
		gate?.remove();
	};
	whenAllowed('funcionais', loadMap);
	// Clicking "Carregar mapa" is an explicit opt-in to functional cookies
	document.querySelector('[data-map-load]')?.addEventListener('click', () => {
		const c = getConsent();
		saveConsent({ funcionais: true, analiticos: c?.analiticos ?? false, publicidade: c?.publicidade ?? false });
	});

	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const error = form?.querySelector<HTMLElement>('[data-form-error]');
	const status = form?.querySelector<HTMLElement>('[data-form-status]');
	const label = form?.querySelector<HTMLElement>('[data-submit-label]');
	const button = form?.querySelector<HTMLButtonElement>('button[type=submit]');

	const show = (kind: 'ok' | 'warn', text: string) => {
		if (!status) return;
		status.hidden = false;
		status.textContent = text;
		status.className = `mt-4 flex items-start gap-2 rounded-2xl p-4 text-sm ${kind === 'ok' ? 'bg-emerald-500/10 text-emerald-300' : 'bg-amber-500/10 text-amber-200'}`;
	};

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const data = new FormData(form);
		const get = (k: string) => String(data.get(k) ?? '').trim();
		if (get('_honey')) return; // bot
		if (!get('nome') || !get('telefone') || !get('mensagem') || !data.get('aceite')) {
			if (error) {
				error.textContent = !data.get('aceite') && get('nome') && get('telefone') && get('mensagem')
					? 'Para enviar, marque que concorda com a Política de Privacidade.'
					: 'Preencha nome, telefone e mensagem.';
				error.hidden = false;
			}
			return;
		}
		if (error) error.hidden = true;
		const text = [
			`Olá! Meu nome é ${get('nome')}.`,
			`Assunto: ${get('assunto')}`,
			`Telefone: ${get('telefone')}`,
			...(get('email') ? [`E-mail: ${get('email')}`] : []),
			'',
			get('mensagem'),
		].join('\n');
		window.dataLayer?.push({ event: 'generate_lead', form_name: 'contato', lead_subject: get('assunto') });

		// 1) E-mail to the office, in the background (keepalive survives the WhatsApp tab opening)
		if (button) button.disabled = true;
		if (label) label.textContent = 'Enviando…';
		fetch(contactForm.endpoint, {
			method: 'POST',
			keepalive: true,
			headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
			body: JSON.stringify({
				_subject: `Novo contato pelo site — ${get('assunto')}`,
				_template: 'table',
				_replyto: get('email') || undefined,
				Nome: get('nome'),
				Telefone: get('telefone'),
				'E-mail': get('email') || '—',
				Assunto: get('assunto'),
				Mensagem: get('mensagem'),
				Origem: window.location.href,
			}),
		})
			.then((r) => r.json().catch(() => ({})).then((j) => ({ ok: r.ok && j.success !== 'false' && j.success !== false })))
			.catch(() => ({ ok: false }))
			.then(({ ok }) => {
				if (ok) {
					show('ok', 'Mensagem enviada! Recebemos seu contato por e-mail e o WhatsApp foi aberto para você falar com a gente agora.');
					form.reset();
				} else {
					show('warn', 'Não conseguimos enviar por e-mail agora, mas o WhatsApp foi aberto com a sua mensagem — é só enviar por lá.');
				}
				if (button) button.disabled = false;
				if (label) label.textContent = 'Enviar mensagem';
			});

		// 2) WhatsApp, synchronously inside the click so pop-up blockers allow it
		// A real link click (not window.open) so the GTM WhatsApp conversion trigger fires
		const link = Object.assign(document.createElement('a'), { href: whatsappMsg(text), target: '_blank', rel: 'noopener' });
		form.append(link);
		link.click();
		link.remove();
	});
</script>
