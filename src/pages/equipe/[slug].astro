---
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import TeamCard from '../../components/TeamCard.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PostCard from '../../components/PostCard.astro';
import { team, contact, whatsappMsg, type Lawyer } from '../../data/site';
import { getPosts } from '../../lib/blog';

export const getStaticPaths = (() => team.map((lawyer) => ({ params: { slug: lawyer.slug }, props: { lawyer } }))) satisfies GetStaticPaths;

const { lawyer } = Astro.props as { lawyer: Lawyer };
const others = team.filter((t) => t.slug !== lawyer.slug).slice(0, 4);
const posts = (await getPosts()).filter((p) => p.data.author === lawyer.slug);
const firstName = lawyer.name.replace(/^Dra?\.\s*/, '').split(' ')[0];
const words = lawyer.name.split(" ");
const half = Math.ceil(words.length / 2);
const nameLines = [words.slice(0, half).join(" "), words.slice(half).join(" ")];
---

<Layout title={lawyer.name} description={`${lawyer.name} — ${lawyer.oab}. ${lawyer.bio.slice(0, 140)}…`}>
	<section class="relative overflow-hidden pt-32 pb-24 md:pt-40">
		<div class="bg-grid absolute inset-0" aria-hidden="true"></div>
		<div class="orb bg-brand/60 -top-40 right-0 h-[30rem] w-[30rem]" data-orb aria-hidden="true"></div>

		<div class="relative mx-auto max-w-7xl px-4 md:px-6">
			<nav data-hero-fade aria-label="Breadcrumb" class="text-mist mb-10 flex flex-wrap items-center gap-2 text-xs">
				<a href="/" class="hover:text-white">Início</a>
				<span class="text-white/25">/</span>
				<a href="/equipe" class="hover:text-white">Equipe</a>
				<span class="text-white/25">/</span>
				<span class="text-white/80">{lawyer.name}</span>
			</nav>

			<div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
				<!-- Photo -->
				<div class="lg:sticky lg:top-28 lg:self-start">
					<div data-hero-visual class="ring-glow relative rounded-[2rem] p-2">
						<div class="bg-ink-3 relative aspect-[4/5] overflow-hidden rounded-[1.6rem]">
							<img src={lawyer.img} alt={lawyer.name} class="h-full w-full scale-110 object-cover object-top" data-hero-img />
							<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
							<div class="glass absolute right-5 bottom-5 left-5 flex items-center justify-between rounded-2xl p-4">
								<div>
									<p class="text-mist text-xs">Inscrição</p>
									<p class="font-mono text-sm font-semibold">{lawyer.oab}</p>
								</div>
								<span class="flex items-center gap-1.5 text-xs text-emerald-400">
									<span class="h-2 w-2 rounded-full bg-emerald-400"></span> Atendendo
								</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Info -->
				<div>
					<p data-hero-fade class="text-brand mb-5 flex items-center gap-3 text-sm font-medium tracking-[0.2em] uppercase">
						<span class="bg-brand h-px w-10"></span>{lawyer.role}
					</p>
					<h1 class="text-[clamp(2.5rem,5.5vw,4.8rem)] leading-[0.95] font-semibold tracking-[-0.045em]">
						{
							nameLines.map((text, i) => (
								<span class="line">
									<span data-hero-line class:list={[i === 1 && 'font-serif font-normal italic text-gradient pr-2']}>{text}</span>
								</span>
							))
						}
					</h1>
					<p data-hero-fade class="text-mist mt-4 flex items-center gap-2">
						<Icon name="lucide:globe" class="h-4 w-4" /> Atuação em todo o Brasil – 100% online
					</p>

					<div data-hero-fade class="mt-8 flex flex-wrap gap-2">
						{lawyer.tags.map((t) => <span class="rounded-full border border-white/12 px-4 py-1.5 text-sm text-white/80">{t}</span>)}
					</div>

					<p data-reveal class="mt-10 text-lg leading-relaxed text-white/80">{lawyer.bio}</p>

					{
						lawyer.education && (
							<div data-reveal class="border-line bg-ink-2 mt-10 rounded-[1.75rem] border p-7">
								<div class="flex items-center gap-3">
									<span class="grid h-10 w-10 place-items-center rounded-xl bg-white/5">
										<Icon name="lucide:graduation-cap" class="text-brand h-5 w-5" />
									</span>
									<h2 class="text-xl font-semibold">Formação acadêmica</h2>
								</div>
								<ul class="mt-6 space-y-3">
									{lawyer.education.map((e) => (
										<li class="text-mist flex gap-3">
											<Icon name="lucide:check" class="text-brand mt-1 h-4 w-4 shrink-0" />
											{e}
										</li>
									))}
								</ul>
							</div>
						)
					}

					{
						lawyer.practice && (
							<div data-reveal class="border-line bg-ink-2 mt-5 rounded-[1.75rem] border p-7">
								<div class="flex items-center gap-3">
									<span class="grid h-10 w-10 place-items-center rounded-xl bg-white/5">
										<Icon name="lucide:briefcase" class="text-brand h-5 w-5" />
									</span>
									<h2 class="text-xl font-semibold">Atuação profissional</h2>
								</div>
								<ul class="mt-6 space-y-3">
									{lawyer.practice.map((e) => (
										<li class="text-mist flex gap-3">
											<Icon name="lucide:check" class="text-brand mt-1 h-4 w-4 shrink-0" />
											{e}
										</li>
									))}
								</ul>
							</div>
						)
					}

					<div data-reveal class="mt-10 flex flex-wrap items-center gap-3">
						<a
							href={whatsappMsg(`Olá! Gostaria de falar com ${lawyer.name}.`)}
							target="_blank"
							rel="noopener"
							data-magnetic
							class="bg-brand inline-flex items-center gap-2 rounded-full px-6 py-3.5 font-semibold text-black transition hover:bg-white"
						>
							<Icon name="lucide:message-circle" class="h-5 w-5" /> Falar com {firstName}
						</a>
						<a
							href={`mailto:${contact.email}`}
							class="inline-flex items-center gap-2 rounded-full border border-white/15 px-6 py-3.5 text-sm font-medium transition hover:border-white/40"
						>
							<Icon name="lucide:mail" class="h-4 w-4" /> E-mail
						</a>
						{
							contact.social.map((s) => (
								<a href={s.href} aria-label={s.label} class="hover:border-brand hover:bg-brand grid h-12 w-12 place-items-center rounded-full border border-white/15 transition hover:text-black">
									<Icon name={s.icon} class="h-4 w-4" />
								</a>
							))
						}
					</div>

					<a href="/equipe" class="text-mist mt-10 inline-flex items-center gap-2 text-sm hover:text-white">
						<Icon name="lucide:arrow-left" class="h-4 w-4" /> Voltar para a equipe
					</a>
				</div>
			</div>
		</div>
	</section>

	{
		posts.length > 0 && (
			<section class="light py-24">
				<div class="mx-auto max-w-7xl px-4 md:px-6">
					<Eyebrow>Artigos de {firstName}</Eyebrow>
					<div class="mt-8 grid gap-8 md:grid-cols-3">
						{posts.map((post) => <PostCard post={post} />)}
					</div>
				</div>
			</section>
		)
	}

	<section class="bg-ink-2 border-t border-white/8 py-24">
		<div class="mx-auto max-w-7xl px-4 md:px-6">
			<Eyebrow>Outros advogados</Eyebrow>
			<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{others.map((p) => <TeamCard lawyer={p} />)}
			</div>
		</div>
	</section>
</Layout>
