---
import Img from '../components/Img.astro';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import TeamCard from '../components/TeamCard.astro';
import Testimonials from '../components/Testimonials.astro';
import { team, contact } from '../data/site';

const stats = [
	{ value: 20, suffix: '+', label: 'anos de expertise jurídica' },
	{ value: 10, suffix: '+', label: 'anos atendendo em Limeira' },
	{ value: 9, suffix: '', label: 'áreas do Direito integradas' },
	{ value: 7, suffix: '', label: 'advogados especialistas' },
];

const hub = [
	{
		icon: 'lucide:message-square-text',
		title: 'Você conta o seu caso',
		text: 'Presencialmente, por WhatsApp ou videochamada. Ouvimos com atenção e sem juridiquês para entender o que realmente importa para você.',
	},
	{
		icon: 'lucide:network',
		title: 'Conectamos o especialista certo',
		text: 'Como uma hub, reunimos diferentes áreas do Direito. Seu caso é direcionado ao profissional com mais experiência naquele tema.',
	},
	{
		icon: 'lucide:layers',
		title: 'Atuação integrada',
		text: 'Quando o problema envolve mais de uma área — trabalhista e previdenciária, civil e tributária — os especialistas trabalham juntos.',
	},
	{
		icon: 'lucide:badge-check',
		title: 'Acompanhamento até o fim',
		text: 'Você é informado a cada movimentação relevante. Transparência do primeiro contato até a solução definitiva.',
	},
];

const pillars = [
	{
		icon: 'lucide:target',
		title: 'Missão',
		text: 'Democratizar o acesso à Justiça, oferecendo soluções jurídicas seguras, estratégicas e personalizadas para pessoas e empresas.',
	},
	{
		icon: 'lucide:telescope',
		title: 'Visão',
		text: 'Ser reconhecida como a hub de soluções jurídicas de referência no interior paulista, unindo tradição e atendimento digital.',
	},
	{
		icon: 'lucide:gem',
		title: 'Valores',
		text: 'Ética, transparência e compromisso com a satisfação de cada cliente, em todas as etapas do atendimento.',
	},
];
---

<Layout
	title="Sobre nós"
	description="Conheça a RC Advogados: hub de soluções jurídicas em Limeira – SP, com mais de duas décadas de experiência e atendimento presencial e digital."
	image="/images/fachada.webp"
>
	<PageHero
		eyebrow="Quem somos"
		lines={['Uma *hub* de', 'soluções jurídicas']}
		lead="Reunimos diferentes áreas do Direito e conectamos especialistas para oferecer suporte completo a pessoas e empresas, com soluções seguras, estratégicas e personalizadas."
		img="/images/fachada.webp"
		imgAlt="Fachada do escritório Reginaldo Costa Advogados Associados em Limeira"
		crumbs={[{ label: 'Sobre' }]}
	/>

	<!-- Story -->
	<section class="light relative py-24 md:py-32">
		<div class="mx-auto grid max-w-7xl gap-14 px-4 md:px-6 lg:grid-cols-2 lg:gap-20">
			<div class="dark-scope relative overflow-hidden rounded-[2rem]" data-clip>
				<Img
					src="/images/escritorio.webp"
					alt="Advogados da RC no escritório de Limeira"
					class="h-full min-h-[460px] w-full scale-125 object-cover"
					data-parallax="-10" sizes="(min-width: 1024px) 64vw, 100vw" />
				<div class="glass absolute right-6 bottom-6 left-6 flex items-center gap-4 rounded-2xl p-4">
					<span class="bg-brand grid h-12 w-12 shrink-0 place-items-center rounded-xl text-black">
						<Icon name="lucide:map-pin" class="h-6 w-6" />
					</span>
					<span class="text-sm">
						<span class="block font-semibold">{contact.street}</span>
						<span class="text-mist">{contact.city}</span>
					</span>
				</div>
			</div>
			<div class="flex flex-col justify-center">
				<Eyebrow>Nossa história</Eyebrow>
				<p data-scrub-words class="text-[clamp(1.6rem,3vw,2.5rem)] leading-[1.15] font-medium tracking-[-0.03em]">
					Há mais de 10 anos exercendo o atendimento jurídico na cidade de Limeira – SP.
				</p>
				<div class="text-mist mt-8 space-y-5 text-lg leading-relaxed">
					<p data-reveal>
						O escritório Reginaldo Costa Advogados Associados conta com profissionais altamente capacitados e
						experientes, pautados na ética, transparência e no compromisso da satisfação dos clientes.
					</p>
					<p data-reveal>
						Nosso atendimento é 100% customizado, para que possamos atender a nossos clientes de acordo com suas
						reais necessidades — presencialmente na nossa sede ou de forma totalmente digital, em qualquer lugar do
						Brasil.
					</p>
				</div>
				<div class="mt-10 grid grid-cols-2 gap-4">
					<div data-reveal class="border-line bg-ink-2 rounded-2xl border p-5">
						<Icon name="lucide:clock-9" class="text-brand h-6 w-6" />
						<p class="mt-4 font-semibold">Suporte 24 horas</p>
					</div>
					<div data-reveal class="border-line bg-ink-2 rounded-2xl border p-5">
						<Icon name="lucide:monitor-smartphone" class="text-brand h-6 w-6" />
						<p class="mt-4 font-semibold">Presencial e digital</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Stats -->
	<section class="border-y border-white/8">
		<div class="mx-auto grid max-w-7xl grid-cols-2 px-4 md:px-6 lg:grid-cols-4">
			{
				stats.map((s, i) => (
					<div data-reveal class:list={['py-12 lg:py-16', i > 0 && 'lg:border-l lg:border-white/8 lg:pl-10', i % 2 && 'max-lg:pl-6']}>
						<p class="text-6xl font-semibold tracking-tight md:text-7xl">
							<span data-counter={s.value}>0</span>
							<span class="text-brand">{s.suffix}</span>
						</p>
						<p class="text-mist mt-3 text-sm">{s.label}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- How the hub works: stacked sticky cards -->
	<section class="light relative py-28 md:py-40">
		<div class="mx-auto grid max-w-7xl gap-14 px-4 md:px-6 lg:grid-cols-[1fr_1.3fr]">
			<div class="lg:sticky lg:top-32 lg:self-start">
				<Eyebrow>Como funciona</Eyebrow>
				<h2 class="text-[clamp(2.4rem,5vw,4.4rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
					<span class="line"><span data-split-line>O modelo</span></span>
					<span class="line"><span data-split-line><span class="font-serif font-normal italic text-brand">hub</span> na prática</span></span>
				</h2>
				<p data-reveal class="text-mist mt-6 max-w-sm">
					Um único ponto de contato, vários especialistas trabalhando pelo seu caso.
				</p>
			</div>
			<div data-stack class="flex flex-col gap-6">
				{
					hub.map((h, i) => (
						<article
							data-stack-card
							class="border-line bg-ink-2 sticky rounded-[2rem] border p-8 shadow-[0_24px_60px_-24px_rgb(0_0_0/0.35)] md:p-10"
							style={`top: ${7 + i * 1.5}rem`}
						>
							<div class="flex items-start justify-between">
								<span class="bg-brand grid h-14 w-14 place-items-center rounded-2xl text-black">
									<Icon name={h.icon} class="h-7 w-7" />
								</span>
								<span aria-hidden="true" data-num={`0${i + 1}`} class="font-mono text-5xl font-semibold text-white/10 before:content-[attr(data-num)]"></span>
							</div>
							<h3 class="mt-12 text-3xl font-semibold tracking-tight">{h.title}</h3>
							<p class="text-mist mt-3 max-w-lg text-lg leading-relaxed">{h.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- Mission / Vision / Values -->
	<section class="bg-ink-2 relative overflow-hidden border-t border-white/8 py-28 md:py-36">
		<div class="orb bg-brand/40 -right-40 top-10 h-[28rem] w-[28rem]" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-7xl px-4 md:px-6">
			<div class="mb-14 max-w-2xl">
				<Eyebrow>Missão, visão e valores</Eyebrow>
				<h2 class="text-[clamp(2.4rem,5vw,4.4rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
					<span class="line"><span data-split-line>Por que nos</span></span>
					<span class="line"><span data-split-line class="font-serif font-normal italic text-brand">escolher?</span></span>
				</h2>
			</div>
			<div class="grid gap-5 md:grid-cols-3">
				{
					pillars.map((p, i) => (
						<div data-reveal class="spotlight group border-line bg-ink rounded-[2rem] border p-8 md:p-10">
							<div class="flex items-center justify-between">
								<span class="group-hover:bg-brand grid h-14 w-14 place-items-center rounded-2xl bg-white/5 transition-colors duration-500 group-hover:text-black">
									<Icon name={p.icon} class="h-7 w-7" />
								</span>
								<span class="text-mist font-mono text-xs">0{i + 1}</span>
							</div>
							<p class="mt-16 text-3xl font-semibold tracking-tight">{p.title}</p>
							<p class="text-mist mt-3 leading-relaxed">{p.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Team preview -->
	<section class="light py-28 md:py-36">
		<div class="mx-auto max-w-7xl px-4 md:px-6">
			<div class="mb-14 flex flex-wrap items-end justify-between gap-6">
				<div>
					<Eyebrow>Advogados</Eyebrow>
					<h2 class="text-[clamp(2.4rem,5vw,4.4rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
						<span class="line"><span data-split-line>Conheça nossos</span></span>
						<span class="line"><span data-split-line class="font-serif font-normal italic text-brand">advogados</span></span>
					</h2>
				</div>
				<a
					data-reveal
					href="/equipe/"
					class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-medium transition hover:border-white/40 hover:bg-white/5"
				>
					Toda a equipe <Icon name="lucide:arrow-right" class="h-4 w-4" />
				</a>
			</div>
			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{team.slice(0, 4).map((p) => <TeamCard lawyer={p} />)}
			</div>
		</div>
	</section>

	<Testimonials light={false} />
</Layout>
